# Copy to .env and fill in real values:   cp .env.example .env && chmod 600 .env
# .env is git-ignored. Never commit it, zip it or show it in screenshots.

# Grafana admin login (http://127.0.0.1:3000)
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change-me-to-a-long-random-password

# Outbound SMTP used by Grafana alerting (host:port).
# Gmail example: smtp.gmail.com:587 with an App Password (Google account > Security > App passwords)
# Mailtrap sandbox example: sandbox.smtp.mailtrap.io:2525
SMTP_HOST=smtp.example.com:587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=app-password-goes-here
SMTP_FROM_ADDRESS=alerts@example.com
SMTP_FROM_NAME="Grafana Alerts (Observability Lab)"
# MandatoryStartTLS | OpportunisticStartTLS | NoStartTLS
SMTP_STARTTLS_POLICY=MandatoryStartTLS

# Test inbox that receives alert e-mails (comma-separate several addresses)
ALERT_EMAIL_TO=your-test-inbox@example.com

# Optional: random share (0..1) of orders that fail with HTTP 500
APP_FAILURE_RATE=0
# Optional: Node Exporter listen address (private obs bridge gateway by default)
NODE_EXPORTER_LISTEN=172.30.0.1:9100
