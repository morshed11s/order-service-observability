{
  "uid": "obs-k8s-logs",
  "title": "MicroK8s Pod Logs (Loki)",
  "tags": [
    "observability",
    "loki",
    "kubernetes"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "editable": true,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "namespace",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "namespace",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "{cluster=\"microk8s\"}",
          "type": 1
        },
        "definition": "label_values({cluster=\"microk8s\"},namespace)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "allValue": ".+",
        "sort": 1,
        "current": {
          "selected": true,
          "text": "orders-demo",
          "value": "orders-demo"
        }
      },
      {
        "name": "pod",
        "label": "pod",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "pod",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "{cluster=\"microk8s\", namespace=~\"$namespace\"}",
          "type": 1
        },
        "definition": "label_values({cluster=\"microk8s\", namespace=~\"$namespace\"},pod)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "container",
        "label": "container",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "container",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "{cluster=\"microk8s\", namespace=~\"$namespace\", pod=~\"$pod\"}",
          "type": 1
        },
        "definition": "label_values({cluster=\"microk8s\", namespace=~\"$namespace\", pod=~\"$pod\"},container)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "search",
        "label": "Line filter (regex)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Log lines per minute by stream",
      "description": "stdout vs stderr log volume for the selected pods.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum by (stream) (count_over_time({cluster=\"microk8s\", namespace=~\"$namespace\", pod=~\"$pod\", container=~\"$container\"} [1m]))",
          "legendFormat": "{{stream}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Errors per minute by pod",
      "description": "Log lines whose JSON level is ERROR.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum by (pod) (count_over_time({cluster=\"microk8s\", namespace=~\"$namespace\", pod=~\"$pod\", container=~\"$container\"} | json | level=\"ERROR\" [1m]))",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Recent errors (stderr, level=ERROR)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 9
      },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "{cluster=\"microk8s\", namespace=~\"$namespace\", pod=~\"$pod\", container=~\"$container\", stream=\"stderr\"} | json | level=\"ERROR\""
        }
      ]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "All workload logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 12
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "{cluster=\"microk8s\", namespace=~\"$namespace\", pod=~\"$pod\", container=~\"$container\"} |~ \"$search\""
        }
      ]
    }
  ]
}