      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "8 * rate(node_network_receive_bytes_total{job=\"node-exporter\",device!~\"lo|veth.*|docker.*|br-.*|cali.*|vxlan.*|flannel.*|cni.*\"}[5m])",
          "legendFormat": "rx {{device}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "8 * rate(node_network_transmit_bytes_total{job=\"node-exporter\",device!~\"lo|veth.*|docker.*|br-.*|cali.*|vxlan.*|flannel.*|cni.*\"}[5m])",
          "legendFormat": "tx {{device}}"
        }
      ]
