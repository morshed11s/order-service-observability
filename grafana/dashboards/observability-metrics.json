          },
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"order-api\"}[1m]))",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 14,
      "type": "stat",
      "title": "5xx error rate",
      "description": "Share of requests answered with HTTP 5xx over 5 minutes. Alert threshold: 5%.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 22,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "(sum(rate(http_requests_total{job=\"order-api\",status=~\"5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(http_requests_total{job=\"order-api\"}[5m])), 0.001)",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 15,
      "type": "stat",
      "title": "p95 latency",
      "description": "95th percentile request latency from the histogram (5m).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
